{
  "name": "@hiro5409/figma-cli",
  "version": "0.1.0",
  "description": "Agent-friendly command line interface for the Figma REST API.",
  "keywords": [
    "bun",
    "cli",
    "comments",
    "design",
    "figma"
  ],
  "homepage": "https://github.com/Hiro5409/figma-cli#readme",
  "bugs": {
    "url": "https://github.com/Hiro5409/figma-cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiro5409/figma-cli.git"
  },
  "bin": {
    "figma-api": "bin/figma-api"
  },
  "files": [
    "bin",
    "skills",
    "src",
    "!src/types/figma/types.gen.ts",
    "!src/types/**/msw.gen.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --compile --outfile figma-api",
    "test": "bun test",
    "check": "bun run check:generated && bun run --parallel --no-exit-on-error check:static knip test check:package check:skill",
    "check:static": "vp check",
    "knip": "knip",
    "check:package": "publint run --pack bun",
    "check:skill": "gh skill publish skills --dry-run",
    "check:generated": "bun run generate-types && git diff --exit-code HEAD -- src/types && test -z \"$(git ls-files --others --exclude-standard -- src/types)\"",
    "prepublishOnly": "bun run check",
    "api-schema:check": "bun scripts/check-api-schema.ts",
    "generate-types": "openapi-ts --file openapi-ts.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "gunshi": "1.0.0-rc.1",
    "ky": "2.2.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.0.0-next-20260930190945",
    "@mswjs/interceptors": "0.45.10",
    "@types/bun": "1.4.4",
    "@typescript-eslint/types": "8.72.1",
    "knip": "6.44.1",
    "msw": "3.0.3",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "js-yaml": "5.5.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
